---
import App from '../App';
import '../styles.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@1..144,1..1000&family=Noto+Emoji:wght@300..700&family=Noto+Sans+SC:wght@100..900&display=swap" rel="stylesheet">
    <title>MihoLens</title>
    <script is:inline>
      const saved = localStorage.getItem("theme")
      const dark = saved === "dark" || ((saved !== "light") && matchMedia("(prefers-color-scheme: dark)").matches)
      document.documentElement.classList.toggle("dark", dark)
    </script>
  </head>
  <body class="bg-page text-ink antialiased">
    <App client:only="react" />
  </body>
</html>
